# サーバーのポート
PORT=3000

# PostgreSQL（docker-compose.yml が読む）
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=express_web_api

# Prisma の接続先
DATABASE_URL=postgresql://app:app_password@localhost:5432/express_web_api?schema=public

# JWT の秘密鍵（本番では長いランダムな値にする）
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
